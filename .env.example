# === VEX Consulting â€” variables de entorno ===

ENV=development
SECRET_KEY=cambiar-esta-clave-larga-y-aleatoria

# Postgres (Render: pegar la Internal Database URL). En dev local puede omitirse
# y se usa SQLite (sin bÃºsqueda vectorial).
# DATABASE_URL=postgresql://user:pass@host:5432/vexconsulting

# --- Superadmin: SOLO se crea acÃ¡, nunca en la aplicaciÃ³n ---
SUPERADMIN_EMAIL=admin@vexconsulting.com.py
SUPERADMIN_NAME=Administrador VEX
SUPERADMIN_PASSWORD=CambiarEstaPassword123!
# Alternativa segura: hash bcrypt (dejar SUPERADMIN_PASSWORD vacÃ­o)
# SUPERADMIN_PASSWORD_HASH=$2b$12$...

# --- Doble factor (TOTP: Google Authenticator, 1Password, Authy) ---
# Obligatorio para TODAS las cuentas: hasta escanear el QR en «Mi perfil» la
# API bloquea todo salvo autenticación. Poner false solo en entornos de prueba.
REQUIRE_2FA=true
# Secreto TOTP del superadmin (base32). Generar con:
#   python -c "import pyotp; print(pyotp.random_base32())"
# y cargarlo a mano en la app de autenticación (cuenta: SUPERADMIN_EMAIL).
SUPERADMIN_TOTP_SECRET=

JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=40

# --- OpenAI (agentes + embeddings) ---
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-terra
AGENT_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small

# --- Perplexity (investigaciÃ³n profunda, opcional) ---
PERPLEXITY_API_KEY=

# OCR para PDFs escaneados (requiere tesseract en la imagen)
OCR_ENABLED=false

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO

